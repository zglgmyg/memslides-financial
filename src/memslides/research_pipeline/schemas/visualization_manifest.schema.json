{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-report-ppt-agent.local/schemas/visualization_manifest.schema.json",
  "title": "Visualization Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "outline_sha256",
    "document_source_sha256",
    "asset_root",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "outline_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "document_source_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "asset_root": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["block", "table", "figure"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "slide_id",
        "visualization_id",
        "visual_type",
        "sources",
        "visualization_file"
      ],
      "properties": {
        "slide_id": {
          "type": "string",
          "pattern": "^slide_[A-Za-z0-9_.-]+$"
        },
        "visualization_id": {
          "type": "string",
          "minLength": 1
        },
        "visual_type": {
          "type": "string",
          "enum": ["chart", "table", "image"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "visualization_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
        }
      },
      "additionalProperties": false
    }
  }
}

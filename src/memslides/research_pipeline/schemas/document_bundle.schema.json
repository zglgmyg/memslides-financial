{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-report-ppt-agent.local/schemas/document_bundle.schema.json",
  "title": "DocumentBundle v0.1",
  "type": "object",
  "required": ["document", "pages", "blocks", "sections", "tables", "figures", "reading_order"],
  "additionalProperties": false,
  "properties": {
    "document": {
      "type": "object",
      "required": ["id", "title", "page_count", "source_sha256", "source_file", "source_format"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": ["string", "null"]},
        "page_count": {"type": "integer", "minimum": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "source_file": {"type": "string", "minLength": 1},
        "source_format": {"enum": ["pdf", "markdown", "plain_text"]},
        "location_model": {"enum": ["pdf_bbox", "line_range"]}
      },
      "additionalProperties": true
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "page", "width", "height", "block_ids"],
        "properties": {
          "id": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "width": {"type": ["number", "null"]},
          "height": {"type": ["number", "null"]},
          "block_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "page", "type", "text_raw", "bbox", "parser_order", "reading_order", "section_id", "source_type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "type": {"type": "string", "minLength": 1},
          "text_raw": {"type": "string"},
          "bbox": {
            "oneOf": [
              {"type": "null"},
              {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4}
            ]
          },
          "parser_order": {"type": "integer", "minimum": 0},
          "reading_order": {"type": "integer", "minimum": 0},
          "section_id": {"type": ["string", "null"]},
          "source_type": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "sections": {"type": "array", "items": {"type": "object"}},
    "tables": {"type": "array", "items": {"type": "object"}},
    "figures": {"type": "array", "items": {"type": "object"}},
    "reading_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narrative_plan.schema.json",
  "title": "Research Report Narrative Plan",
  "type": "object",
  "required": ["schema_version", "title", "audience", "presentation_purpose", "thesis", "sections", "closing_message"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "title": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "presentation_purpose": {"type": "string", "minLength": 1},
    "thesis": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    },
    "closing_message": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["block", "table", "figure"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["claim", "evidence_refs"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_ref"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["section_goal", "source_section_refs", "key_claims", "transition_intent"],
      "properties": {
        "section_goal": {"type": "string", "minLength": 1},
        "source_section_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "key_claims": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/claim"}
        },
        "transition_intent": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}

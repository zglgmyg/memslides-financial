{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-report-ppt-agent.local/schemas/metric_group.schema.json",
  "title": "Verified Metric Group Catalog",
  "type": "object",
  "required": ["schema_version", "group_count", "groups"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "group_count": {"type": "integer", "minimum": 0},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "candidate_id", "intent", "metric_key", "measure_kind", "unit_family", "unit", "unit_scale", "currency", "scope", "fact_ids", "scenarios", "forecast_start_index"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^metric_group_[a-f0-9]+$"},
          "candidate_id": {"type": "string", "minLength": 1},
          "intent": {"enum": ["trend", "comparison", "composition"]},
          "metric_key": {"type": "string", "not": {"const": "unknown"}},
          "measure_kind": {"enum": ["amount", "ratio", "growth_rate", "share", "per_share", "multiple", "count"]},
          "unit_family": {"enum": ["currency", "percentage", "multiple", "count", "capacity", "volume", "dimensionless"]},
          "unit": {"type": "string"},
          "unit_scale": {"type": "string"},
          "currency": {"type": "string"},
          "scope": {"type": "string", "minLength": 1},
          "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^fact_[a-f0-9]+$"}},
          "scenarios": {"type": "array", "minItems": 1, "items": {"enum": ["actual", "estimate", "guidance", "target"]}},
          "forecast_start_index": {"type": ["integer", "null"], "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

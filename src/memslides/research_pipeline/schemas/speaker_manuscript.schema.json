{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "speaker_manuscript.schema.json",
  "title": "Slide-aligned Speaker Manuscript",
  "type": "object",
  "required": ["schema_version", "metadata", "opening", "slides", "closing"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "metadata": {
      "type": "object",
      "required": ["title", "audience", "presentation_purpose", "estimated_total_minutes"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "presentation_purpose": {"type": "string", "minLength": 1},
        "estimated_total_minutes": {"type": "integer", "minimum": 1, "maximum": 180}
      },
      "additionalProperties": true
    },
    "opening": {"type": "string", "minLength": 1},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide_script"}
    },
    "closing": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["block", "table", "figure"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "slide_script": {
      "type": "object",
      "required": [
        "slide_id",
        "slide_title",
        "narrative_role",
        "script",
        "transition_to_next",
        "evidence_refs",
        "estimated_seconds"
      ],
      "properties": {
        "slide_id": {"type": "string", "minLength": 1},
        "slide_title": {"type": "string", "minLength": 1},
        "narrative_role": {
          "enum": ["opening", "context", "fact", "evidence", "comparison", "cause", "interpretation", "summary", "risk", "closing"]
        },
        "script": {"type": "string", "minLength": 1},
        "transition_to_next": {"type": "string"},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_ref"},
          "uniqueItems": true
        },
        "estimated_seconds": {"type": "integer", "minimum": 5, "maximum": 600}
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outline_few_shot_case.schema.json",
  "title": "Outline Few-shot Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "category",
    "priority",
    "match",
    "guidance",
    "example"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "content",
        "evidence",
        "visualization",
        "boundary"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "any", "none"],
      "properties": {
        "all": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "any": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "none": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable_when", "recommended", "avoid"],
      "properties": {
        "applicable_when": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "recommended": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "avoid": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "example": {
      "type": "object",
      "minProperties": 1
    }
  }
}
